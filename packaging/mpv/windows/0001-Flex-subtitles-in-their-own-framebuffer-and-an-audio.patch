diff --git a/video/out/gpu/libmpv_gpu.c b/video/out/gpu/libmpv_gpu.c
index 2d8f442..1737eaf 100644
--- a/video/out/gpu/libmpv_gpu.c
+++ b/video/out/gpu/libmpv_gpu.c
@@ -192,9 +192,27 @@ static int render(struct render_backend *ctx, mpv_render_param *params,
                                              &(int){0});
 
     struct ra_fbo target = {.tex = tex, .flip = flip};
-    gl_video_render_frame(p->renderer, frame, &target, RENDER_FRAME_DEF);
+    void *subtitle_fbo =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_OPENGL_SUBTITLE_FBO, NULL);
+    int flags = RENDER_FRAME_DEF;
+    if (subtitle_fbo)
+        flags &= ~RENDER_FRAME_SUBS;
+    gl_video_render_frame(p->renderer, frame, &target, flags);
     p->context->fns->done_frame(p->context, frame->display_synced);
 
+    if (subtitle_fbo) {
+        mpv_render_param sub_params[] = {
+            {MPV_RENDER_PARAM_OPENGL_FBO, subtitle_fbo},
+            {MPV_RENDER_PARAM_INVALID, NULL},
+        };
+        err = p->context->fns->wrap_fbo(p->context, sub_params, &tex);
+        if (err < 0)
+            return err;
+        struct ra_fbo sub_target = {.tex = tex, .flip = flip};
+        gl_video_render_subtitles(p->renderer, &sub_target);
+        p->context->fns->done_frame(p->context, frame->display_synced);
+    }
+
     return 0;
 }
 
diff --git a/video/out/gpu/video.c b/video/out/gpu/video.c
index 6122e51..b3553f3 100644
--- a/video/out/gpu/video.c
+++ b/video/out/gpu/video.c
@@ -3546,6 +3546,16 @@ static void gl_video_interpolate_frame(struct gl_video *p, struct vo_frame *t,
     p->frames_drawn += 1;
 }
 
+// Subtitles for the frame just rendered, alone on transparency.
+void gl_video_render_subtitles(struct gl_video *p, const struct ra_fbo *fbo)
+{
+    struct mp_rect target_rc = {0, 0, fbo->tex->params.w, fbo->tex->params.h};
+    float transparent[4] = {0.0, 0.0, 0.0, 0.0};
+    p->ra->fns->clear(p->ra, fbo->tex, transparent, &target_rc);
+    if (p->osd)
+        pass_draw_osd(p, OSD_DRAW_SUB_ONLY, RENDER_FRAME_SUBS, p->osd_pts, p->osd_rect, fbo, true);
+}
+
 void gl_video_render_frame(struct gl_video *p, struct vo_frame *frame,
                            const struct ra_fbo *fbo, int flags)
 {
