diff --git a/audio/filter/af_flextap.c b/audio/filter/af_flextap.c
new file mode 100644
index 0000000..dde4866
--- /dev/null
+++ b/audio/filter/af_flextap.c
@@ -0,0 +1,90 @@
+// Flex's patch: hands the audio passing through to a callback, as interleaved floats, leaving
+// it unchanged. Added like any other filter (af add flextap).
+
+#include <stdatomic.h>
+
+#include "audio/aframe.h"
+#include "audio/format.h"
+#include "common/common.h"
+#include "filters/f_autoconvert.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "mpv/client.h"
+#include "osdep/threads.h"
+
+static mp_static_mutex tap_lock = MP_STATIC_MUTEX_INITIALIZER;
+static mpv_flex_audio_tap tap_fn;
+static void *tap_ctx;
+
+void mpv_flex_set_audio_tap(mpv_flex_audio_tap fn, void *ctx)
+{
+    mp_mutex_lock(&tap_lock);
+    tap_fn = fn;
+    tap_ctx = ctx;
+    mp_mutex_unlock(&tap_lock);
+}
+
+struct priv {
+    struct mp_pin *in;
+};
+
+static void af_flextap_process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_can_transfer_data(f->ppins[1], p->in))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(p->in);
+    if (frame.type == MP_FRAME_AUDIO) {
+        struct mp_aframe *a = frame.data;
+        uint8_t **data = mp_aframe_get_data_ro(a);
+        if (data && mp_aframe_get_format(a) == AF_FORMAT_FLOAT) {
+            mp_mutex_lock(&tap_lock);
+            if (tap_fn) {
+                tap_fn(tap_ctx, (const float *)data[0], mp_aframe_get_channels(a),
+                       mp_aframe_get_size(a), mp_aframe_get_rate(a),
+                       mp_aframe_get_pts(a));
+            }
+            mp_mutex_unlock(&tap_lock);
+        }
+    }
+    mp_pin_in_write(f->ppins[1], frame);
+}
+
+static const struct mp_filter_info af_flextap_filter = {
+    .name = "flextap",
+    .priv_size = sizeof(struct priv),
+    .process = af_flextap_process,
+};
+
+static struct mp_filter *af_flextap_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &af_flextap_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    struct priv *p = f->priv;
+    struct mp_autoconvert *conv = mp_autoconvert_create(f);
+    if (!conv)
+        abort();
+    mp_autoconvert_add_afmt(conv, AF_FORMAT_FLOAT);
+    mp_pin_connect(conv->f->pins[0], f->ppins[0]);
+    p->in = conv->f->pins[1];
+
+    talloc_free(options);
+    return f;
+}
+
+const struct mp_user_filter_entry af_flextap = {
+    .desc = {
+        .name = "flextap",
+        .description = "Hand the audio to Flex",
+    },
+    .create = af_flextap_create,
+};
