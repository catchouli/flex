diff --git a/include/mpv/client.h b/include/mpv/client.h
index f970b9a..44d9272 100644
--- a/include/mpv/client.h
+++ b/include/mpv/client.h
@@ -2026,6 +2026,17 @@ MPV_DEFINE_SYM_PTR(mpv_get_wakeup_pipe)
 
 #endif
 
+/**
+ * Flex's patch: called with the audio going through the "flextap" filter, as interleaved
+ * floats. frames is how many frames of channels samples there are, pts their time (or
+ * negative if unknown). It's called on an audio thread, and has to return quickly.
+ */
+typedef void (*mpv_flex_audio_tap)(void *ctx, const float *samples, int channels,
+                                   int frames, int rate, double pts);
+
+/** Sets the function the "flextap" filter calls, for the whole process, or NULL for none. */
+MPV_EXPORT void mpv_flex_set_audio_tap(mpv_flex_audio_tap fn, void *ctx);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/include/mpv/render.h b/include/mpv/render.h
index 0b59982..c8db811 100644
--- a/include/mpv/render.h
+++ b/include/mpv/render.h
@@ -435,6 +435,13 @@ typedef enum mpv_render_param_type {
      * Type: mpv_d3d11_fbo*
      */
     MPV_RENDER_PARAM_D3D11_FBO = 22,
+    /**
+     * Flex's patch: draw subtitles into this mpv_opengl_fbo instead of onto the
+     * picture. It's cleared to transparent, and holds premultiplied alpha.
+     * Valid for mpv_render_context_render().
+     * Type: mpv_opengl_fbo*
+     */
+    MPV_RENDER_PARAM_OPENGL_SUBTITLE_FBO = 1000,
 } mpv_render_param_type;
 
 /**
