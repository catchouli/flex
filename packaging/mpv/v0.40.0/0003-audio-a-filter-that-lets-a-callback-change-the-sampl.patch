+ */
+
+// Flex's patch: lets a callback change the audio passing through, as interleaved floats, in
+// place. A second callback is told when the filter is cleared (on seeks), so whatever the first
+// holds back can be dropped. Added like any other filter (af add flexsound).
+
+#include "audio/aframe.h"
+#include "audio/format.h"
+#include "common/common.h"
+#include "filters/f_autoconvert.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "mpv/client.h"
+#include "osdep/threads.h"
+
+static mp_static_mutex sound_lock = MP_STATIC_MUTEX_INITIALIZER;
+static mpv_flex_sound sound_fn;
+static mpv_flex_sound_reset reset_fn;
+static void *sound_ctx;
+
+void mpv_flex_set_sound(mpv_flex_sound fn, mpv_flex_sound_reset reset, void *ctx)
+{
+    mp_mutex_lock(&sound_lock);
+    sound_fn = fn;
+    reset_fn = reset;
+    sound_ctx = ctx;
+    mp_mutex_unlock(&sound_lock);
+}
+
+struct priv {
+    struct mp_pin *in;
+};
+
+static void af_flexsound_process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_can_transfer_data(f->ppins[1], p->in))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(p->in);
+    if (frame.type == MP_FRAME_AUDIO) {
+        struct mp_aframe *a = frame.data;
+        if (mp_aframe_get_format(a) == AF_FORMAT_FLOAT) {
+            mp_mutex_lock(&sound_lock);
+            if (sound_fn) {
+                uint8_t **data = mp_aframe_get_data_rw(a);
+                if (data) {
+                    sound_fn(sound_ctx, (float *)data[0], mp_aframe_get_channels(a),
+                             mp_aframe_get_size(a), mp_aframe_get_rate(a),
+                             mp_aframe_get_pts(a));
+                }
+            }
+            mp_mutex_unlock(&sound_lock);
+        }
+    }
+    mp_pin_in_write(f->ppins[1], frame);
+}
+
+static void af_flexsound_reset(struct mp_filter *f)
+{
+    mp_mutex_lock(&sound_lock);
+    if (reset_fn)
+        reset_fn(sound_ctx);
+    mp_mutex_unlock(&sound_lock);
+}
+
+static const struct mp_filter_info af_flexsound_filter = {
+    .name = "flexsound",
+    .priv_size = sizeof(struct priv),
+    .process = af_flexsound_process,
+    .reset = af_flexsound_reset,
+};
+
+static struct mp_filter *af_flexsound_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &af_flexsound_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    struct priv *p = f->priv;
+    struct mp_autoconvert *conv = mp_autoconvert_create(f);
+    if (!conv)
+        abort();
+    mp_autoconvert_add_afmt(conv, AF_FORMAT_FLOAT);
+    mp_pin_connect(conv->f->pins[0], f->ppins[0]);
+    p->in = conv->f->pins[1];
+
+    talloc_free(options);
+    return f;
+}
+
+const struct mp_user_filter_entry af_flexsound = {
+    .desc = {
+        .name = "flexsound",
+        .description = "Let Flex change the audio",
+    },
+    .create = af_flexsound_create,
+};
