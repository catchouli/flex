diff --git a/include/mpv/client.h b/include/mpv/client.h
index 7551035..e0cc924 100644
--- a/include/mpv/client.h
+++ b/include/mpv/client.h
@@ -2036,6 +2036,21 @@ typedef void (*mpv_flex_audio_tap)(void *ctx, const float *samples, int channels
 /** Sets the function the "flextap" filter calls, for the whole process, or NULL for none. */
 MPV_EXPORT void mpv_flex_set_audio_tap(mpv_flex_audio_tap fn, void *ctx);
 
+/**
+ * Flex's patch: called with the audio going through the "flexsound" filter, as interleaved
+ * floats, to change in place. frames is how many frames of channels samples there are, pts
+ * their time (or negative if unknown). It's called on an audio thread, and has to return
+ * quickly.
+ */
+typedef void (*mpv_flex_sound)(void *ctx, float *samples, int channels, int frames, int rate,
+                               double pts);
+
+/** Called when the "flexsound" filter is cleared (on seeks): what came before is over. */
+typedef void (*mpv_flex_sound_reset)(void *ctx);
+
+/** Sets the functions the "flexsound" filter calls, for the whole process, or NULL for none. */
+MPV_EXPORT void mpv_flex_set_sound(mpv_flex_sound fn, mpv_flex_sound_reset reset, void *ctx);
+
 #ifdef __cplusplus
 }
 #endif
