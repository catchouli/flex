From f54bd35fa8a01a9f69ae9860873d9c0c3acec3ab Mon Sep 17 00:00:00 2001
From: flex-build <build@localhost>
Date: Mon, 9 Nov 2026 20:41:01 +0000
Subject: [PATCH 1/3] render: let the subtitles be drawn into their own
 framebuffer

---
 include/mpv/render.h       |  7 +++++++
 video/out/gpu/libmpv_gpu.c | 20 +++++++++++++++++++-
 video/out/gpu/video.c      | 10 ++++++++++
 video/out/gpu/video.h      |  1 +
 4 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/include/mpv/render.h b/include/mpv/render.h
index 99aadeb..55c01ad 100644
--- a/include/mpv/render.h
+++ b/include/mpv/render.h
@@ -422,6 +422,13 @@ typedef enum mpv_render_param_type {
      * See MPV_RENDER_PARAM_SW_STRIDE for alignment requirements.
      */
     MPV_RENDER_PARAM_SW_POINTER = 20,
+    /**
+     * Flex's patch: draw subtitles into this mpv_opengl_fbo instead of onto the
+     * picture. It's cleared to transparent, and holds premultiplied alpha.
+     * Valid for mpv_render_context_render().
+     * Type: mpv_opengl_fbo*
+     */
+    MPV_RENDER_PARAM_OPENGL_SUBTITLE_FBO = 1000,
 } mpv_render_param_type;
 
 /**
diff --git a/video/out/gpu/libmpv_gpu.c b/video/out/gpu/libmpv_gpu.c
index 6c812f9..872dbde 100644
--- a/video/out/gpu/libmpv_gpu.c
+++ b/video/out/gpu/libmpv_gpu.c
@@ -187,9 +187,27 @@ static int render(struct render_backend *ctx, mpv_render_param *params,
                                              &(int){0});
 
     struct ra_fbo target = {.tex = tex, .flip = flip};
-    gl_video_render_frame(p->renderer, frame, &target, RENDER_FRAME_DEF);
+    void *subtitle_fbo =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_OPENGL_SUBTITLE_FBO, NULL);
+    int flags = RENDER_FRAME_DEF;
+    if (subtitle_fbo)
+        flags &= ~RENDER_FRAME_SUBS;
+    gl_video_render_frame(p->renderer, frame, &target, flags);
     p->context->fns->done_frame(p->context, frame->display_synced);
 
+    if (subtitle_fbo) {
+        mpv_render_param sub_params[] = {
+            {MPV_RENDER_PARAM_OPENGL_FBO, subtitle_fbo},
+            {MPV_RENDER_PARAM_INVALID, NULL},
+        };
+        err = p->context->fns->wrap_fbo(p->context, sub_params, &tex);
+        if (err < 0)
+            return err;
+        struct ra_fbo sub_target = {.tex = tex, .flip = flip};
+        gl_video_render_subtitles(p->renderer, &sub_target);
+        p->context->fns->done_frame(p->context, frame->display_synced);
+    }
+
     return 0;
 }
 
diff --git a/video/out/gpu/video.c b/video/out/gpu/video.c
index 5796ef1..1a7b4a0 100644
--- a/video/out/gpu/video.c
+++ b/video/out/gpu/video.c
@@ -3392,6 +3392,16 @@ static void gl_video_interpolate_frame(struct gl_video *p, struct vo_frame *t,
     p->frames_drawn += 1;
 }
 
+// Subtitles for the frame just rendered, alone on transparency.
+void gl_video_render_subtitles(struct gl_video *p, const struct ra_fbo *fbo)
+{
+    struct mp_rect target_rc = {0, 0, fbo->tex->params.w, fbo->tex->params.h};
+    float transparent[4] = {0.0, 0.0, 0.0, 0.0};
+    p->ra->fns->clear(p->ra, fbo->tex, transparent, &target_rc);
+    if (p->osd)
+        pass_draw_osd(p, OSD_DRAW_SUB_ONLY, RENDER_FRAME_SUBS, p->osd_pts, p->osd_rect, fbo, true);
+}
+
 void gl_video_render_frame(struct gl_video *p, struct vo_frame *frame,
                            const struct ra_fbo *fbo, int flags)
 {
diff --git a/video/out/gpu/video.h b/video/out/gpu/video.h
index 00e843c..86572d2 100644
--- a/video/out/gpu/video.h
+++ b/video/out/gpu/video.h
@@ -194,6 +194,7 @@ void gl_video_uninit(struct gl_video *p);
 void gl_video_set_osd_source(struct gl_video *p, struct osd_state *osd);
 bool gl_video_check_format(struct gl_video *p, int mp_format);
 void gl_video_config(struct gl_video *p, struct mp_image_params *params);
+void gl_video_render_subtitles(struct gl_video *p, const struct ra_fbo *fbo);
 void gl_video_render_frame(struct gl_video *p, struct vo_frame *frame,
                            const struct ra_fbo *fbo, int flags);
 void gl_video_resize(struct gl_video *p,
-- 
2.47.3

