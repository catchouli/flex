{
  "name": "Flex",
  "short_name": "Flex",
  "description": "Remote and library browser for Flex",
  "start_url": "/#/remote",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e0f12",
  "theme_color": "#0e0f12",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
